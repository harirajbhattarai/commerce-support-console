# Local FastAPI configuration
PORT=8000
HOST=127.0.0.1
# Comma-separated list of origins allowed to perform CORS requests (e.g. Shopify domains and localhost)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://hoverboardstore.co.uk,https://www.hoverboardstore.co.uk
# Admin token password gate (leave blank to disable auth gates in local development)
ADMIN_DASHBOARD_TOKEN=your-secure-admin-token-here

# Supabase Production Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Amazon SP-API Configuration (Mandatory for Standard Calls)
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.your-client-id
AMAZON_LWA_CLIENT_SECRET=your-lwa-client-secret
AMAZON_LWA_REFRESH_TOKEN=Atzr|your-lwa-refresh-token
AMAZON_REGION=eu-west-1
AMAZON_MARKETPLACE_ID=A1F83G8C2ARO7P

# Optional/Legacy AWS IAM Configuration (Only required for SQS notifications / AWS services if needed later)
AMAZON_AWS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
AMAZON_AWS_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AMAZON_ROLE_ARN=arn:aws:iam::123456789012:role/your-sp-api-role


